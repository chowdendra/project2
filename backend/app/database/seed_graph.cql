// ========================================================
// AtmoGraph - Supply Chain Knowledge Graph Cypher Schema
// Run in Neo4j Browser / Neo4j Desktop / Neo4j Aura
// ========================================================

// 1. Clear existing supply chain graph elements
MATCH (n:SupplyChainEntity) DETACH DELETE n;

// 2. Create Unique Constraints
CREATE CONSTRAINT entity_id_unique IF NOT EXISTS FOR (e:SupplyChainEntity) REQUIRE e.id IS UNIQUE;

// 3. Create Supply Chain Nodes
CREATE (:Supplier:SupplyChainEntity {id: 'SUP-LITHIUM-01', name: 'Albemarle Salar Extraction', type: 'Supplier', tier: 'Tier-3', industry: 'Automotive / Energy', country: 'Chile', lead_time_days: 45, inventory_buffer_days: 14, criticality_score: 0.88, financial_volume_mil: 650.0, description: 'High-purity brine lithium carbonate extraction for battery cathode production.', current_status: 'Normal'});
CREATE (:Supplier:SupplyChainEntity {id: 'SUP-SILICON-02', name: 'Shin-Etsu Silicon Crystals', type: 'Supplier', tier: 'Tier-3', industry: 'Electronics', country: 'Japan', lead_time_days: 30, inventory_buffer_days: 20, criticality_score: 0.92, financial_volume_mil: 820.0, description: 'Electronic-grade silicon ingots and high-purity polysilicon wafers.', current_status: 'Normal'});
CREATE (:Supplier:SupplyChainEntity {id: 'SUP-COBALT-03', name: 'Katanga Cobalt Reserves', type: 'Supplier', tier: 'Tier-3', industry: 'Automotive / Energy', country: 'DR Congo', lead_time_days: 50, inventory_buffer_days: 10, criticality_score: 0.82, financial_volume_mil: 420.0, description: 'Refined battery-grade cobalt cathode precursors.', current_status: 'Normal'});
CREATE (:Supplier:SupplyChainEntity {id: 'SUP-CHEM-04', name: 'BASF Specialty Chemicals', type: 'Supplier', tier: 'Tier-3', industry: 'Pharmaceuticals', country: 'Germany', lead_time_days: 21, inventory_buffer_days: 25, criticality_score: 0.85, financial_volume_mil: 910.0, description: 'Reagents, active pharmaceutical precursors and organic synthesizers.', current_status: 'Normal'});
CREATE (:Supplier:SupplyChainEntity {id: 'SUP-CHIP-TSMC', name: 'TSMC Fab 18', type: 'Supplier', tier: 'Tier-2', industry: 'Electronics', country: 'Taiwan', lead_time_days: 35, inventory_buffer_days: 12, criticality_score: 0.98, financial_volume_mil: 3400.0, description: 'Advanced 3nm and 5nm logic semiconductor fabrication foundry.', current_status: 'Normal'});
CREATE (:Supplier:SupplyChainEntity {id: 'SUP-CHIP-ASML', name: 'ASML Veldhoven Optics', type: 'Supplier', tier: 'Tier-2', industry: 'Electronics', country: 'Netherlands', lead_time_days: 60, inventory_buffer_days: 30, criticality_score: 0.99, financial_volume_mil: 2900.0, description: 'EUV photolithography equipment and precision optical stepper systems.', current_status: 'Normal'});
CREATE (:Supplier:SupplyChainEntity {id: 'SUP-BATT-CATL', name: 'CATL Battery Cells', type: 'Supplier', tier: 'Tier-2', industry: 'Automotive / Energy', country: 'China', lead_time_days: 28, inventory_buffer_days: 15, criticality_score: 0.91, financial_volume_mil: 2100.0, description: 'LFP and NMC automotive prismatic and cylindrical lithium cell blocks.', current_status: 'Normal'});
CREATE (:Supplier:SupplyChainEntity {id: 'SUP-API-DIVI', name: 'Divi\'s Active Ingredients', type: 'Supplier', tier: 'Tier-2', industry: 'Pharmaceuticals', country: 'India', lead_time_days: 18, inventory_buffer_days: 30, criticality_score: 0.79, financial_volume_mil: 550.0, description: 'Active Pharmaceutical Ingredients (API) for antibiotics and pain medications.', current_status: 'Normal'});
CREATE (:Port:SupplyChainEntity {id: 'PORT-ROTTERDAM', name: 'Port of Rotterdam', type: 'Port', tier: 'Logistics Hub', industry: 'Multi-Industry', country: 'Netherlands', lead_time_days: 7, inventory_buffer_days: 5, criticality_score: 0.96, financial_volume_mil: 4800.0, description: 'Europe\'s largest transshipment seaport handling 470 million tons of freight.', current_status: 'Normal'});
CREATE (:Port:SupplyChainEntity {id: 'PORT-SHANGHAI', name: 'Port of Shanghai (Yangshan)', type: 'Port', tier: 'Logistics Hub', industry: 'Multi-Industry', country: 'China', lead_time_days: 5, inventory_buffer_days: 6, criticality_score: 0.97, financial_volume_mil: 6200.0, description: 'World\'s busiest container port linking East Asia with European and American trade.', current_status: 'Normal'});
CREATE (:Port:SupplyChainEntity {id: 'PORT-SINGAPORE', name: 'Port of Singapore', type: 'Port', tier: 'Logistics Hub', industry: 'Multi-Industry', country: 'Singapore', lead_time_days: 4, inventory_buffer_days: 7, criticality_score: 0.94, financial_volume_mil: 5100.0, description: 'Global premier transshipment hub connecting Indian Ocean and Pacific routes.', current_status: 'Normal'});
CREATE (:Port:SupplyChainEntity {id: 'PORT-LA-LONG-BEACH', name: 'Port of Los Angeles / Long Beach', type: 'Port', tier: 'Logistics Hub', industry: 'Multi-Industry', country: 'USA', lead_time_days: 6, inventory_buffer_days: 6, criticality_score: 0.93, financial_volume_mil: 4300.0, description: 'Primary Pacific gateway handling 35% of all containerized maritime imports into the US.', current_status: 'Normal'});
CREATE (:Manufacturer:SupplyChainEntity {id: 'MFG-BOSCH-AUTO', name: 'Bosch Mobility Stuttgart', type: 'Manufacturer', tier: 'Tier-1', industry: 'Automotive', country: 'Germany', lead_time_days: 14, inventory_buffer_days: 10, criticality_score: 0.9, financial_volume_mil: 1800.0, description: 'Engine control units (ECU), ABS brake actuators, and automotive radar sensors.', current_status: 'Normal'});
CREATE (:Manufacturer:SupplyChainEntity {id: 'MFG-FOXCONN-01', name: 'Foxconn Zhengzhou Complex', type: 'Manufacturer', tier: 'Tier-1', industry: 'Electronics', country: 'China', lead_time_days: 10, inventory_buffer_days: 8, criticality_score: 0.95, financial_volume_mil: 4500.0, description: 'Precision electronic contract assembly for high-end smartphones and tablets.', current_status: 'Normal'});
CREATE (:Manufacturer:SupplyChainEntity {id: 'MFG-NOVARTIS-FORM', name: 'Novartis Drug Formulation', type: 'Manufacturer', tier: 'Tier-1', industry: 'Pharmaceuticals', country: 'Switzerland', lead_time_days: 16, inventory_buffer_days: 20, criticality_score: 0.87, financial_volume_mil: 1400.0, description: 'Sterile injectable ampoules, oncology therapeutics, and cardiovascular tablets.', current_status: 'Normal'});
CREATE (:Manufacturer:SupplyChainEntity {id: 'OEM-TESLA-GIGA', name: 'Tesla Gigafactory Berlin', type: 'Manufacturer', tier: 'OEM', industry: 'Automotive', country: 'Germany', lead_time_days: 8, inventory_buffer_days: 6, criticality_score: 0.92, financial_volume_mil: 3100.0, description: 'Electric passenger vehicle assembly (Model Y) and structural battery pack integration.', current_status: 'Normal'});
CREATE (:Manufacturer:SupplyChainEntity {id: 'OEM-APPLE-GLOBAL', name: 'Apple Global Operations', type: 'Manufacturer', tier: 'OEM', industry: 'Electronics', country: 'USA', lead_time_days: 7, inventory_buffer_days: 7, criticality_score: 0.96, financial_volume_mil: 7500.0, description: 'Consumer smart hardware final packaging, iOS calibration, and firmware flashing.', current_status: 'Normal'});
CREATE (:Manufacturer:SupplyChainEntity {id: 'OEM-BMW-MUNICH', name: 'BMW Werk Munich', type: 'Manufacturer', tier: 'OEM', industry: 'Automotive', country: 'Germany', lead_time_days: 9, inventory_buffer_days: 8, criticality_score: 0.89, financial_volume_mil: 2800.0, description: 'Luxury sedans and electric drivetrains assembly lines.', current_status: 'Normal'});
CREATE (:Warehouse:SupplyChainEntity {id: 'WH-DHL-EUROPE', name: 'DHL European Central Hub', type: 'Warehouse', tier: 'Distribution Hub', industry: 'Multi-Industry', country: 'Germany', lead_time_days: 3, inventory_buffer_days: 12, criticality_score: 0.86, financial_volume_mil: 1600.0, description: 'Air express sorting depot and temperature-controlled medical logistics terminal.', current_status: 'Normal'});
CREATE (:Warehouse:SupplyChainEntity {id: 'WH-FEDEX-MEMPHIS', name: 'FedEx SuperHub Memphis', type: 'Warehouse', tier: 'Distribution Hub', industry: 'Multi-Industry', country: 'USA', lead_time_days: 2, inventory_buffer_days: 10, criticality_score: 0.88, financial_volume_mil: 2200.0, description: 'Global freight sorting facility processing over 3.3 million shipments daily.', current_status: 'Normal'});
CREATE (:Distributor:SupplyChainEntity {id: 'DIST-AMAZON-EU', name: 'Amazon EU Fulfillment Network', type: 'Distributor', tier: 'Retail Distribution', industry: 'Electronics / Multi', country: 'Luxembourg', lead_time_days: 2, inventory_buffer_days: 5, criticality_score: 0.91, financial_volume_mil: 5800.0, description: 'Pan-European distribution network supplying prime next-day deliveries.', current_status: 'Normal'});
CREATE (:Retailer:SupplyChainEntity {id: 'DIST-BESTBUY-NA', name: 'Best Buy North America Supply', type: 'Retailer', tier: 'Retail Distribution', industry: 'Electronics', country: 'USA', lead_time_days: 3, inventory_buffer_days: 7, criticality_score: 0.82, financial_volume_mil: 1900.0, description: 'Consumer electronics omnichannel retail chain spanning 1,000+ outlets.', current_status: 'Normal'});
CREATE (:Distributor:SupplyChainEntity {id: 'DIST-MCKESSON-MED', name: 'McKesson Healthcare Logistics', type: 'Distributor', tier: 'Retail Distribution', industry: 'Pharmaceuticals', country: 'USA', lead_time_days: 1, inventory_buffer_days: 14, criticality_score: 0.94, financial_volume_mil: 4200.0, description: 'Distributes 1/3 of all pharmaceuticals used across North American hospitals and pharmacies.', current_status: 'Normal'});

// 4. Create Supply Chain Directed Relationships
MATCH (s:SupplyChainEntity {id: 'SUP-LITHIUM-01'}), (t:SupplyChainEntity {id: 'SUP-BATT-CATL'}) CREATE (s)-[:SUPPLIES_TO {product: 'Lithium Carbonate', transit_time_days: 22, shipping_mode: 'Maritime', dependency_weight: 0.85}]->(t);
MATCH (s:SupplyChainEntity {id: 'SUP-COBALT-03'}), (t:SupplyChainEntity {id: 'SUP-BATT-CATL'}) CREATE (s)-[:SUPPLIES_TO {product: 'Cobalt Cathodes', transit_time_days: 25, shipping_mode: 'Maritime', dependency_weight: 0.75}]->(t);
MATCH (s:SupplyChainEntity {id: 'SUP-SILICON-02'}), (t:SupplyChainEntity {id: 'SUP-CHIP-TSMC'}) CREATE (s)-[:SUPPLIES_TO {product: 'Pure Silicon Wafers', transit_time_days: 6, shipping_mode: 'Air Freight', dependency_weight: 0.95}]->(t);
MATCH (s:SupplyChainEntity {id: 'SUP-CHIP-ASML'}), (t:SupplyChainEntity {id: 'SUP-CHIP-TSMC'}) CREATE (s)-[:SUPPLIES_TO {product: 'EUV Lithography Systems', transit_time_days: 14, shipping_mode: 'Air Freight', dependency_weight: 0.98}]->(t);
MATCH (s:SupplyChainEntity {id: 'SUP-CHEM-04'}), (t:SupplyChainEntity {id: 'SUP-API-DIVI'}) CREATE (s)-[:SUPPLIES_TO {product: 'Chemical Precursors', transit_time_days: 18, shipping_mode: 'Maritime', dependency_weight: 0.7}]->(t);
MATCH (s:SupplyChainEntity {id: 'SUP-BATT-CATL'}), (t:SupplyChainEntity {id: 'PORT-SHANGHAI'}) CREATE (s)-[:TRANSSHIPS_VIA {product: 'Battery Modules', transit_time_days: 3, shipping_mode: 'Trucking', dependency_weight: 0.9}]->(t);
MATCH (s:SupplyChainEntity {id: 'SUP-CHIP-TSMC'}), (t:SupplyChainEntity {id: 'PORT-SINGAPORE'}) CREATE (s)-[:TRANSSHIPS_VIA {product: 'Microchips & Processors', transit_time_days: 4, shipping_mode: 'Air Freight', dependency_weight: 0.8}]->(t);
MATCH (s:SupplyChainEntity {id: 'SUP-API-DIVI'}), (t:SupplyChainEntity {id: 'PORT-SINGAPORE'}) CREATE (s)-[:TRANSSHIPS_VIA {product: 'Bulk API Powder', transit_time_days: 5, shipping_mode: 'Maritime', dependency_weight: 0.65}]->(t);
MATCH (s:SupplyChainEntity {id: 'PORT-SHANGHAI'}), (t:SupplyChainEntity {id: 'PORT-ROTTERDAM'}) CREATE (s)-[:TRANSSHIPS_VIA {product: 'Containerized Cargo', transit_time_days: 28, shipping_mode: 'Maritime', dependency_weight: 0.85}]->(t);
MATCH (s:SupplyChainEntity {id: 'PORT-SINGAPORE'}), (t:SupplyChainEntity {id: 'PORT-ROTTERDAM'}) CREATE (s)-[:TRANSSHIPS_VIA {product: 'Global Cargo Transshipment', transit_time_days: 21, shipping_mode: 'Maritime', dependency_weight: 0.8}]->(t);
MATCH (s:SupplyChainEntity {id: 'PORT-SHANGHAI'}), (t:SupplyChainEntity {id: 'PORT-LA-LONG-BEACH'}) CREATE (s)-[:TRANSSHIPS_VIA {product: 'Trans-Pacific Electronics', transit_time_days: 16, shipping_mode: 'Maritime', dependency_weight: 0.9}]->(t);
MATCH (s:SupplyChainEntity {id: 'PORT-ROTTERDAM'}), (t:SupplyChainEntity {id: 'MFG-BOSCH-AUTO'}) CREATE (s)-[:SUPPLIES_TO {product: 'Semiconductors & Sensors', transit_time_days: 2, shipping_mode: 'Rail', dependency_weight: 0.78}]->(t);
MATCH (s:SupplyChainEntity {id: 'SUP-CHIP-TSMC'}), (t:SupplyChainEntity {id: 'MFG-FOXCONN-01'}) CREATE (s)-[:SUPPLIES_TO {product: 'Bionic & M-Series SoCs', transit_time_days: 2, shipping_mode: 'Air Freight', dependency_weight: 0.95}]->(t);
MATCH (s:SupplyChainEntity {id: 'PORT-ROTTERDAM'}), (t:SupplyChainEntity {id: 'MFG-NOVARTIS-FORM'}) CREATE (s)-[:SUPPLIES_TO {product: 'Specialty Chemical Drums', transit_time_days: 3, shipping_mode: 'Rail', dependency_weight: 0.72}]->(t);
MATCH (s:SupplyChainEntity {id: 'SUP-API-DIVI'}), (t:SupplyChainEntity {id: 'MFG-NOVARTIS-FORM'}) CREATE (s)-[:SUPPLIES_TO {product: 'Antibiotic Base', transit_time_days: 6, shipping_mode: 'Air Freight', dependency_weight: 0.6}]->(t);
MATCH (s:SupplyChainEntity {id: 'PORT-ROTTERDAM'}), (t:SupplyChainEntity {id: 'OEM-TESLA-GIGA'}) CREATE (s)-[:SUPPLIES_TO {product: 'Imported Battery Cells', transit_time_days: 3, shipping_mode: 'Rail', dependency_weight: 0.88}]->(t);
MATCH (s:SupplyChainEntity {id: 'MFG-BOSCH-AUTO'}), (t:SupplyChainEntity {id: 'OEM-TESLA-GIGA'}) CREATE (s)-[:SUPPLIES_TO {product: 'Braking & Steering Units', transit_time_days: 2, shipping_mode: 'Trucking', dependency_weight: 0.75}]->(t);
MATCH (s:SupplyChainEntity {id: 'MFG-BOSCH-AUTO'}), (t:SupplyChainEntity {id: 'OEM-BMW-MUNICH'}) CREATE (s)-[:SUPPLIES_TO {product: 'Automotive Telematics & ECU', transit_time_days: 1, shipping_mode: 'Trucking', dependency_weight: 0.88}]->(t);
MATCH (s:SupplyChainEntity {id: 'MFG-FOXCONN-01'}), (t:SupplyChainEntity {id: 'OEM-APPLE-GLOBAL'}) CREATE (s)-[:SUPPLIES_TO {product: 'Finished Smart Devices', transit_time_days: 5, shipping_mode: 'Air Freight', dependency_weight: 0.96}]->(t);
MATCH (s:SupplyChainEntity {id: 'OEM-TESLA-GIGA'}), (t:SupplyChainEntity {id: 'WH-DHL-EUROPE'}) CREATE (s)-[:STORES_FOR {product: 'Service Parts & Vehicles', transit_time_days: 1, shipping_mode: 'Trucking', dependency_weight: 0.65}]->(t);
MATCH (s:SupplyChainEntity {id: 'OEM-BMW-MUNICH'}), (t:SupplyChainEntity {id: 'WH-DHL-EUROPE'}) CREATE (s)-[:STORES_FOR {product: 'Finished Automobiles', transit_time_days: 1, shipping_mode: 'Rail', dependency_weight: 0.7}]->(t);
MATCH (s:SupplyChainEntity {id: 'OEM-APPLE-GLOBAL'}), (t:SupplyChainEntity {id: 'WH-FEDEX-MEMPHIS'}) CREATE (s)-[:STORES_FOR {product: 'Consumer Electronics Stock', transit_time_days: 2, shipping_mode: 'Air Freight', dependency_weight: 0.9}]->(t);
MATCH (s:SupplyChainEntity {id: 'MFG-NOVARTIS-FORM'}), (t:SupplyChainEntity {id: 'WH-DHL-EUROPE'}) CREATE (s)-[:STORES_FOR {product: 'Packaged Prescription Drugs', transit_time_days: 1, shipping_mode: 'Trucking', dependency_weight: 0.8}]->(t);
MATCH (s:SupplyChainEntity {id: 'MFG-NOVARTIS-FORM'}), (t:SupplyChainEntity {id: 'DIST-MCKESSON-MED'}) CREATE (s)-[:SUPPLIES_TO {product: 'Bulk Hospital Formulations', transit_time_days: 8, shipping_mode: 'Air Freight', dependency_weight: 0.85}]->(t);
MATCH (s:SupplyChainEntity {id: 'WH-DHL-EUROPE'}), (t:SupplyChainEntity {id: 'DIST-AMAZON-EU'}) CREATE (s)-[:DISTRIBUTES_TO {product: 'E-Commerce Prime Parcels', transit_time_days: 1, shipping_mode: 'Trucking', dependency_weight: 0.82}]->(t);
MATCH (s:SupplyChainEntity {id: 'WH-FEDEX-MEMPHIS'}), (t:SupplyChainEntity {id: 'DIST-BESTBUY-NA'}) CREATE (s)-[:DISTRIBUTES_TO {product: 'Retail Store Replenishment', transit_time_days: 2, shipping_mode: 'Trucking', dependency_weight: 0.88}]->(t);
MATCH (s:SupplyChainEntity {id: 'PORT-LA-LONG-BEACH'}), (t:SupplyChainEntity {id: 'DIST-BESTBUY-NA'}) CREATE (s)-[:DISTRIBUTES_TO {product: 'Direct Import Consumer Tech', transit_time_days: 3, shipping_mode: 'Trucking', dependency_weight: 0.72}]->(t);

// 5. Verification Query: Return all nodes and edges
MATCH (n:SupplyChainEntity)-[r]->(m:SupplyChainEntity) RETURN n, r, m LIMIT 100;
